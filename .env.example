# 사내 OpenAI-compatible LLM 설정
INTERNAL_LLM_BASE_URL=https://your-internal-llm-endpoint/v1
INTERNAL_LLM_API_KEY=replace-me
INTERNAL_LLM_MODEL=your-internal-model-name

# 대부분의 분류 작업은 temperature 0 권장
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=300
LLM_MAX_TOKENS=1200

# 사내 endpoint가 response_format={"type":"json_object"}를 지원할 때만 1로 설정
LLM_USE_JSON_RESPONSE_FORMAT=0

# Qwen3/Qwen3.6 계열은 thinking mode 때문에 content가 빈 응답으로 내려오는 경우가 있어 기본적으로 비활성화
LLM_QWEN_DISABLE_THINKING=1

# 사내 OpenAI-compatible endpoint에 추가 body가 필요하면 JSON 객체로 지정
# 예: {"chat_template_kwargs":{"enable_thinking":false}}
LLM_EXTRA_BODY_JSON=
