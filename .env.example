# 사내 OpenAI-compatible LLM 설정
LLM_ENDPOINT_PROFILE=internal
INTERNAL_LLM_BASE_URL=https://your-internal-llm-endpoint/v1
INTERNAL_LLM_API_KEY=replace-me
INTERNAL_LLM_MODEL=qwen3.6-35b-a3b

# Alibaba/DashScope OpenAI-compatible API를 쓰려면 LLM_ENDPOINT_PROFILE=alibaba로 설정
ALIBABA_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ALIBABA_API_KEY=replace-me
ALIBABA_MODEL=qwen-plus

# auto는 모델명에 따라 qwen/glm/generic 프로파일을 자동 선택
LLM_PROVIDER_PROFILE=auto

# 대부분의 분류 작업은 temperature 0 권장
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=300
# Qwen thinking mode를 쓸 때는 비워두면 LLM_QWEN_THINKING_MAX_TOKENS가 적용됨
LLM_MAX_TOKENS=

# 사내 endpoint가 response_format={"type":"json_object"}를 지원할 때만 1로 설정
LLM_USE_JSON_RESPONSE_FORMAT=0

# Qwen3/Qwen3.6 계열은 분류 품질을 우선해 기본적으로 thinking mode를 사용
# 지식 저장/메모리 정리 호출은 코드에서 별도로 thinking을 비활성화
LLM_QWEN_DISABLE_THINKING=0
LLM_QWEN_MAX_TOKENS=

# Qwen thinking mode 사용 시 LLM_MAX_TOKENS가 비어 있으면 이 값을 사용
# thinking 토큰이 먼저 소모되므로 1200보다 크게 잡는 것이 안전
LLM_QWEN_THINKING_MAX_TOKENS=4096
LLM_QWEN_EXTRA_BODY_JSON=

# GLM 계열은 Qwen 전용 extra body를 보내지 않음
LLM_GLM_MAX_TOKENS=2048
LLM_GLM_EXTRA_BODY_JSON=

# 사내 OpenAI-compatible endpoint에 추가 body가 필요하면 JSON 객체로 지정
# 예: {"chat_template_kwargs":{"enable_thinking":true}}
LLM_EXTRA_BODY_JSON=
